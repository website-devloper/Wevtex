# ── Contact form email (Resend) ─────────────────────────────
# Used by app/api/contact/route.ts to deliver leads from the home form.

# Your Resend API key — create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives new lead notifications (e.g. leads@wevtex.com)
LEAD_NOTIFY_EMAIL=leads@wevtex.com

# Verified Resend sender. The domain must be verified in Resend.
# Format: "Display Name <address@yourdomain>"
LEAD_FROM_EMAIL=Wevtex <hello@wevtex.com>

# ── Analytics (GA4) ─────────────────────────────────────────
# Google Analytics 4 Measurement ID. Find it in GA4: Admin → Data Streams.
# Public by design (NEXT_PUBLIC_ vars reach the browser). Leave blank to disable.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Dashboard (Keystatic) ──────────────────────────────────────────────
# Only needed in production: locally the dashboard writes to the files
# directly and asks for no login.
#
# How to get them, once (about two minutes):
#   1. npm run cms:setup
#      A page opens, you press one button, GitHub asks you to confirm, and the
#      three GitHub values are written here. Nothing else needs to be running:
#      it does not use the dev server.
#   2. Install the App on the repo — the success page links straight to it.
#   3. Copy the four KEYSTATIC_* lines into your host's environment settings and
#      redeploy.
#
# Check the state at any time with:  npm run cms:check
#
# Until they are set, the deployed dashboard still opens and shows the content,
# but cannot save. The site itself is unaffected either way.

# Written for you by the setup above (GitHub issues it).
KEYSTATIC_GITHUB_CLIENT_ID=

# Written for you by the setup above (GitHub issues it).
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Written for you by the setup above: Keystatic generates it. It signs the
# dashboard's session cookie, and must be at least 32 characters.
KEYSTATIC_SECRET=

# Written for you by the setup above: the App's URL name. Public by design.
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
